# Copiar a .env y completar antes de ejecutar `docker compose up`.
# Ver docs/04-software-architecture.md (seccion 5) y docs/adr/0006-configurable-llm-model-selection.md

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Modelo configurable, nunca hardcodeado en el codigo (ADR-0006). Por defecto: Claude Haiku 4.5.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- PostgreSQL ---
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=asistente_rag
DATABASE_URL=postgresql+psycopg://rag_app:changeme@postgres:5432/asistente_rag

# --- ChromaDB ---
CHROMA_PERSIST_DIR=/app/data/chroma

# --- Pipeline RAG (parametros experimentales congelados para reproducibilidad) ---
# Ver docs/11-reproducibility.md y docs/10-addendum-tecnico-implementacion.md (seccion VII).
# No modificar durante la ejecucion de la Fase V del protocolo sin actualizar ambos documentos.
RAG_TOP_K=10
RAG_MIN_SIMILARITY_THRESHOLD=0.35
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_CHROMA_COLLECTION_NAME=institutional_documents

# --- Autenticacion ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=changeme
ALLOWED_EMAIL_DOMAIN=uvg.edu.gt
# Lista separada por comas de correos que se registran con rol admin (EPIC-7, ADR-0008).
# Mecanismo de arranque minimo: no hay una pantalla de gestion de roles en esta version.
ADMIN_EMAILS=
# Cuenta sembrada automaticamente al arrancar, solo para la demo del sprint 1 (ADR-0011).
# Cambiar/rotar antes de cualquier despliegue mas alla de la demo local.
DEFAULT_ADMIN_EMAIL=admin@uvg.edu.gt
DEFAULT_ADMIN_PASSWORD=admin123

# --- Aplicacion ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DOCUMENTS_STORAGE_DIR=/app/data/documents
# Corpus de arranque (sprint 1 demo, ADR-0011): PDFs indexados automaticamente al iniciar.
SEED_DOCUMENTS_DIR=/app/documents

# --- Frontend ---
# URL que el navegador usa para llamar al backend directamente (sin proxy inverso).
VITE_API_BASE_URL=http://localhost:8000
